# Copy to .env and fill in your own values. Never commit .env.
DATABASE_URL="<postgres connection string>"
AUTH_SECRET="<random 32+ char string>"
NEXTAUTH_SECRET="<same as AUTH_SECRET>"

# Cloud storage for uploaded games (S3-compatible)
AWS_BUCKET_NAME="<bucket>"
AWS_FOLDER_PREFIX="<prefix/>"
AWS_REGION="<region>"

# Seed data
SEED_ADMIN_PASSWORD="<password for the radu admin account>"
SEED_ADMIN_EMAIL="radu@hostedgames.app"
